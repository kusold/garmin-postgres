# Database connection
DATABASE_URL=postgresql://garmin:garmin@localhost:5432/garmin

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# How many days of historical data to fetch per ingestion run
INGEST_DAYS_BACK=1

# Notion sync configuration
NOTION_TOKEN=
NOTION_ACTIVITIES_DB_ID=
NOTION_DAILY_STEPS_DB_ID=
NOTION_PERSONAL_RECORDS_DB_ID=
NOTION_TIMEZONE=UTC
